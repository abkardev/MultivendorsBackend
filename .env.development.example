# ============================================================
# Server Configuration
# ============================================================
PORT=9000
NODE_ENV=development

# ============================================================
# MongoDB
# ============================================================
MONGODB_URI=mongodb://localhost:27017/marketplace-dev

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=dev-jwt-secret-do-not-use-in-production
JWT_EXPIRES=30d

# ============================================================
# Frontend
# ============================================================
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# ============================================================
# Storage Provider
# ============================================================
STORAGE_PROVIDER=cloudflare_r2
STORAGE_LEGACY_BUNNYCDN=false

# --- BunnyCDN (Legacy) ---
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_HOSTNAME=storage.bunnycdn.com

# --- Cloudflare R2 ---
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_BUCKET=manus-public-dev
CF_R2_PROTECTED_BUCKET=manus-protected-dev
CF_R2_PUBLIC_URL=http://localhost:9000/uploads

# --- Cloudflare CDN ---
CF_CDN_ZONE_ID=
CF_CDN_DOMAIN=
CF_CDN_API_TOKEN=

# --- Cloudflare Images ---
CF_IMAGES_ENABLED=false
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_API_TOKEN=
CF_IMAGES_DEFAULT_QUALITY=85

# --- Cloudflare Turnstile ---
# Use test keys for local development
CF_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CF_TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# --- Cloudflare Stream ---
CF_STREAM_ENABLED=false
CF_STREAM_API_TOKEN=

# ============================================================
# Payment Gateways
# ============================================================
# Use Stripe test keys for development
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your_test_subscription_webhook_secret

# ============================================================
# AI / LLM Assistant
# ============================================================
AI_PROVIDER=builtin
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
AI_TIMEOUT=60000
AI_MAX_TOKENS=1000

# ============================================================
# Translation Service (Enterprise Multi-Language)
# ============================================================
# TRANSLATION_PROVIDER=
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
