# ============================================================
# Server Configuration
# ============================================================
# Port the server listens on
PORT=9000
# Application environment: development | staging | production
NODE_ENV=development

# ============================================================
# MongoDB
# ============================================================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/marketplace

# ============================================================
# Redis (optional; falls back to in-memory cache)
# ============================================================
# REDIS_URL=redis://localhost:6379

# ============================================================
# JWT Authentication
# ============================================================
# Secret key for signing JWT tokens.
# In production, startup refuses secrets that are missing, shorter than
# 64 characters, or known default/development/placeholder values.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET
# JWT token expiration duration
JWT_EXPIRES=7d

# ============================================================
# Frontend
# ============================================================
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# ============================================================
# Email (SMTP) — required for reset/2FA emails. jsonTransport used only in dev.
# ============================================================
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Manus Security" <no-reply@yourdomain.com>

# ============================================================
# Storage Provider
# ============================================================
# Storage backend: cloudflare_r2 | bunnycdn (legacy)
STORAGE_PROVIDER=cloudflare_r2
# Set to true if migrating from BunnyCDN (keeps legacy files accessible)
STORAGE_LEGACY_BUNNYCDN=false

# --- BunnyCDN (Legacy - remove after migration) ---
# Access key for BunnyCDN storage
BUNNYCDN_ACCESS_KEY=
# BunnyCDN storage zone name
BUNNYCDN_STORAGE_ZONE=
# BunnyCDN storage hostname
BUNNYCDN_HOSTNAME=storage.bunnycdn.com

# --- Cloudflare R2 ---
# Cloudflare R2 account ID
CF_ACCOUNT_ID=
# Cloudflare R2 access key ID
CF_R2_ACCESS_KEY_ID=
# Cloudflare R2 secret access key
CF_R2_SECRET_ACCESS_KEY=
# Public bucket name (serves images/assets publicly)
CF_R2_PUBLIC_BUCKET=manus-public
# Protected bucket name (serves protected/private files)
CF_R2_PROTECTED_BUCKET=manus-protected
# Public URL for the R2 bucket (your custom domain or r2.dev URL)
CF_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# --- Cloudflare CDN ---
# Cloudflare CDN / zone ID
CF_CDN_ZONE_ID=
# Cloudflare CDN domain (e.g., cdn.yourdomain.com)
CF_CDN_DOMAIN=
# Cloudflare CDN API token
CF_CDN_API_TOKEN=

# --- Cloudflare Images ---
# Enable Cloudflare Images integration
CF_IMAGES_ENABLED=true
# Cloudflare Images account hash
CF_IMAGES_ACCOUNT_HASH=
# Cloudflare Images API token
CF_IMAGES_API_TOKEN=
# Default image quality (1-100)
CF_IMAGES_DEFAULT_QUALITY=85

# --- Cloudflare Turnstile (CAPTCHA) ---
# Turnstile site key (used by frontend)
CF_TURNSTILE_SITE_KEY=
# Turnstile secret key (used by backend for verification)
CF_TURNSTILE_SECRET_KEY=

# --- Cloudflare Stream (Future) ---
# Enable Cloudflare Stream for video uploads/streaming
CF_STREAM_ENABLED=false
# Cloudflare Stream API token
CF_STREAM_API_TOKEN=

# ============================================================
# Payment Gateways
# ============================================================
# PAYMENT_MODE: live | test. test allows simulated checkout outside production.
PAYMENT_MODE=test

# --- Stripe (subscriptions only) ---
# Stripe secret key (starts with sk_live_ in production)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe webhook signing secret for subscription events
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_...
STRIPE_SUBSCRIPTIONS_ENABLED=false

# --- Moyasar (primary card gateway, KSA) ---
# MOYASAR_API_KEY=sk_test_...
# MOYASAR_WEBHOOK_SECRET=...
# MOYASAR_MODE=sandbox

# --- HyperPay (fallback card gateway, KSA) ---
# HYPERPAY_ENTITY_ID=...
# HYPERPAY_ACCESS_TOKEN=...
# HYPERPAY_SECRET_KEY=...
# HYPERPAY_WEBHOOK_SECRET=...
# HYPERPAY_MODE=sandbox

# --- PayPal (optional fallback) ---
# How to obtain: https://developer.paypal.com -> app credentials
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=sandbox   # sandbox | live
# PAYPAL_ENABLED=false  # webhooks fail closed unless set to true
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com  # https://api-m.paypal.com for live
# PAYPAL_WEBHOOK_ID=... # required to verify webhook signatures via verify-webhook-signature API

# --- PayTabs (optional fallback, KSA) ---
# How to obtain: https://dashboard.paytabs.com -> merchant API keys
# PAYTABS_SERVER_KEY=...
# PAYTABS_PROFILE_ID=...
# PAYTABS_MODE=sandbox

# --- Adyen (dormant adapter; requires a DB PaymentProviderConfig record, no env) ---
# ADYEN_HMAC_KEY=...   # used ONLY by webhookSecurity for Adyen notifications

# ============================================================
# AI / LLM Assistant
# ============================================================
# AI provider: builtin | openai | anthropic
AI_PROVIDER=builtin
# OpenAI API key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=
# OpenAI model to use
OPENAI_MODEL=gpt-4o-mini
# Anthropic API key (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Anthropic model to use
ANTHROPIC_MODEL=claude-3-haiku-20240307
# AI request timeout in milliseconds
AI_TIMEOUT=30000
# Maximum tokens per AI response
AI_MAX_TOKENS=1000

# ============================================================
# Translation Service (Enterprise Multi-Language)
# ============================================================
# Translation provider: openai | deepl | google
# TRANSLATION_PROVIDER=
# DeepL API key
# DEEPL_API_KEY=
# Google Translate API key
# GOOGLE_TRANSLATE_API_KEY=
