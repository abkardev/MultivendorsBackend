# ============================================================
# Server Configuration
# ============================================================
# Port the server listens on
PORT=9000
# Application environment
NODE_ENV=production

# ============================================================
# MongoDB
# ============================================================
# MongoDB connection string (use a replica set for production)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/marketplace?retryWrites=true&w=majority

# ============================================================
# Redis (optional in production, recommended for scaling)
# ============================================================
REDIS_URL=redis://redis:6379

# ============================================================
# JWT Authentication
# ============================================================
# Secret key for signing JWT tokens. Production refuses to start unless this is
# a cryptographically random secret of >= 64 chars with no known default/
# placeholder value. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET
# JWT token expiration duration
JWT_EXPIRES=7d

# ============================================================
# Frontend
# ============================================================
# Comma-separated list of allowed frontend origins (your production domains)
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# ============================================================
# Email (SMTP) — MANDATORY. Startup fails loudly if unset.
# ============================================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Your Marketplace" <no-reply@yourdomain.com>
# SMTP_ENABLED=false   # only if email is intentionally off in production

# ============================================================
# Storage Provider
# ============================================================
# Storage backend: cloudflare_r2 | bunnycdn (legacy)
STORAGE_PROVIDER=cloudflare_r2
# Set to true if migrating from BunnyCDN
STORAGE_LEGACY_BUNNYCDN=false

# --- BunnyCDN (Legacy) ---
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_HOSTNAME=storage.bunnycdn.com

# --- Cloudflare R2 ---
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_BUCKET=manus-public
CF_R2_PROTECTED_BUCKET=manus-protected
CF_R2_PUBLIC_URL=https://cdn.yourdomain.com

# --- Cloudflare CDN ---
CF_CDN_ZONE_ID=
CF_CDN_DOMAIN=cdn.yourdomain.com
CF_CDN_API_TOKEN=

# --- Cloudflare Images ---
CF_IMAGES_ENABLED=true
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_API_TOKEN=
CF_IMAGES_DEFAULT_QUALITY=85

# --- Cloudflare Turnstile (CAPTCHA) ---
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# --- Cloudflare Stream ---
CF_STREAM_ENABLED=true
CF_STREAM_API_TOKEN=

# ============================================================
# Payments
# ============================================================
# PAYMENT_MODE: live | test. Production MUST be live.
PAYMENT_MODE=live

# --- Stripe (subscriptions only, behind STRIPE_SUBSCRIPTIONS_ENABLED) ---
STRIPE_SECRET_KEY=sk_live_your_live_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your_live_subscription_webhook_secret
STRIPE_SUBSCRIPTIONS_ENABLED=false
# STRIPE_PRICE_STARTER=price_your_starter_price_id
# STRIPE_PRICE_GROWTH=price_your_growth_price_id
# STRIPE_PRICE_PRO=price_your_pro_price_id

# --- Moyasar (primary card gateway, KSA) ---
# Sandbox key: starts with sk_test_; live key: starts with sk_live_
MOYASAR_API_KEY=sk_live_your_moyasar_key
MOYASAR_WEBHOOK_SECRET=your_moyasar_webhook_secret
# MOYASAR_MODE=sandbox   # sandbox | production (default sandbox)

# --- HyperPay (fallback card gateway, KSA) ---
HYPERPAY_ENTITY_ID=your_hyperpay_entity_id
HYPERPAY_ACCESS_TOKEN=your_hyperpay_access_token
HYPERPAY_SECRET_KEY=your_hyperpay_secret_key
HYPERPAY_WEBHOOK_SECRET=your_hyperpay_webhook_secret
# HYPERPAY_MODE=sandbox   # sandbox | production (default sandbox)

# ============================================================
# AI / LLM Assistant
# ============================================================
# AI provider: builtin | openai | anthropic
AI_PROVIDER=openai
# OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key
# OpenAI model to use
OPENAI_MODEL=gpt-4o
# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Anthropic model to use
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AI request timeout in milliseconds
AI_TIMEOUT=60000
# Maximum tokens per AI response
AI_MAX_TOKENS=4096

# ============================================================
# Translation Service (Enterprise Multi-Language)
# ============================================================
# TRANSLATION_PROVIDER=
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

# ============================================================
# Feature flags — set deliberately.
# ============================================================
FEATURE_WHATSAPP=false
FEATURE_GOVERNMENT_VERIFICATION=true
# Real government verification must never run in mock mode in production:
GOV_VERIFICATION_MOCK=false
STORAGE_LEGACY_BUNNYCDN=false

# ============================================================
# Backups (npm run backup / npm run restore)
# ============================================================
MONGODB_BACKUP_DIR=./backups
MONGODB_BACKUP_RETENTION_DAYS=7
MONGODB_BACKUP_OPLOG=true
