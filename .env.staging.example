# ============================================================
# Server Configuration
# ============================================================
PORT=9000
NODE_ENV=staging

# ============================================================
# MongoDB
# ============================================================
MONGODB_URI=mongodb+srv://user:password@staging-cluster.mongodb.net/marketplace-staging?retryWrites=true&w=majority

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES=7d

# ============================================================
# Frontend
# ============================================================
FRONTEND_URL=https://staging.yourdomain.com,http://localhost:5173

# ============================================================
# Storage Provider
# ============================================================
STORAGE_PROVIDER=cloudflare_r2
STORAGE_LEGACY_BUNNYCDN=false

# --- BunnyCDN (Legacy) ---
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_HOSTNAME=storage.bunnycdn.com

# --- Cloudflare R2 ---
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_BUCKET=manus-public-staging
CF_R2_PROTECTED_BUCKET=manus-protected-staging
CF_R2_PUBLIC_URL=https://staging-cdn.yourdomain.com

# --- Cloudflare CDN ---
CF_CDN_ZONE_ID=
CF_CDN_DOMAIN=staging-cdn.yourdomain.com
CF_CDN_API_TOKEN=

# --- Cloudflare Images ---
CF_IMAGES_ENABLED=true
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_API_TOKEN=
CF_IMAGES_DEFAULT_QUALITY=85

# --- Cloudflare Turnstile ---
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# --- Cloudflare Stream ---
CF_STREAM_ENABLED=false
CF_STREAM_API_TOKEN=

# ============================================================
# Payment Gateways
# ============================================================
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_webhook_secret
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=whsec_your_staging_subscription_webhook_secret

# ============================================================
# AI / LLM Assistant
# ============================================================
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307
AI_TIMEOUT=30000
AI_MAX_TOKENS=2048

# ============================================================
# Translation Service (Enterprise Multi-Language)
# ============================================================
# TRANSLATION_PROVIDER=
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
